          "source": "src/minimal_kanban/services/card_service.py",
          "pattern": "def preview_repair_order_print_documents(self, payload: dict | None = None)"
        }
      },
      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_artifact_preview_clipboard_and_retired_routes_do_not_forge_mutation_events"
