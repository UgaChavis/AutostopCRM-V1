{
  "format": "autostopcrm_change_feed_producer_parity_v1",
  "change_types": [
    "archive",
    "create",
    "delete",
    "move",
    "restore",
    "update"
  ],
  "entity_domains": [
    "attachment",
    "board_settings",
    "card",
    "cash_transaction",
    "cashbox",
    "client",
    "client_vehicle",
    "column",
    "employee",
