      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_repair_order_children_emit_exact_commit_bound_create_update_delete"
        },
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_failed_state_replace_aborts_outbox_and_next_commit_is_exact_and_gapless"
        },
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_state_lifecycle_covers_move_archive_restore_and_tombstone"
        },
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_validation_error_and_notification_seen_state_have_correct_event_semantics"
        }
      ]
    },
    {
      "name": "shared_file_index_projection",
      "kind": "shared_files_projection",
      "producer": "shared_files",
      "sinks": [
