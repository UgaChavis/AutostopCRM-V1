          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_print_projection_covers_templates_settings_and_inspection_drafts"
        }
      ]
    },
    {
      "name": "open_card_composite_projection",
      "kind": "composite_projection",
      "producer": "state_projection plus operator_users",
      "sinks": [
        "_save_bundle",
        "_write_state"
      ],
      "routes": [
        "/api/open_card"
      ],
      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_validation_error_and_notification_seen_state_have_correct_event_semantics"
