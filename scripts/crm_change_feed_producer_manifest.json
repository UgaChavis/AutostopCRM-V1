        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_operator_projection_excludes_sessions_but_tracks_user_lifecycle"
        }
      ]
    },
    {
      "name": "card_print_audit_manual_printer_boundary",
      "kind": "mixed_audit_infrastructure",
      "producer": "audit_event for a CRM card; external printer is authoritative for manual documents",
      "sinks": [
        "_save_bundle"
      ],
      "routes": [
        "/api/print_repair_order_documents"
      ],
      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_print_command_audits_card_scope_and_exempts_manual_external_printer_scope"
        }
      ]
    },
    {
      "name": "human_operator_session_privacy_boundary",
      "kind": "privacy_exemption",
      "producer": "none",
      "rationale": "Ephemeral browser credentials and session tokens are privacy and authentication state, not CRM business mutations.",
      "routes": [
        "/api/login_operator",
        "/api/logout_operator"
      ],
      "route_evidence": {
        "/api/login_operator": {
          "source": "src/minimal_kanban/operator_auth.py",
          "pattern": "def login(self, payload: dict | None = None)"
        },
        "/api/logout_operator": {
          "source": "src/minimal_kanban/operator_auth.py",
          "pattern": "def logout(self, payload: dict | None = None)"
        }
      },
      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_operator_projection_excludes_sessions_but_tracks_user_lifecycle"
        }
      ]
    },
    {
      "name": "cashbox_notification_receipt_privacy_boundary",
      "kind": "privacy_exemption",
      "producer": "none",
      "rationale": "Per-operator cashbox notification receipts are private viewer state, not CRM business mutations; projecting them would expose activity and create a self-observation loop when a user opens the cashbox workspace.",
      "routes": [
        "/api/mark_cashbox_notifications_seen"
      ],
      "route_evidence": {
        "/api/mark_cashbox_notifications_seen": {
          "source": "src/minimal_kanban/services/card_service_finance.py",
          "pattern": "def mark_cashbox_notifications_seen(self, payload: dict | None = None)"
        }
      },
      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_validation_error_and_notification_seen_state_have_correct_event_semantics"
        }
      ]
    },
    {
      "name": "personal_board_view_privacy_boundary",
      "kind": "privacy_exemption",
      "producer": "none",
      "rationale": "Per-operator extra-column visibility and tag rules are private UI state, not CRM business mutations; projecting them would reveal a person's private work view.",
      "routes": [
        "/api/update_personal_board_preferences"
      ],
      "route_evidence": {
        "/api/update_personal_board_preferences": {
          "source": "src/minimal_kanban/operator_auth.py",
          "pattern": "def update_personal_board_preferences(self, payload: dict | None = None)"
        }
      },
      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_personal_board_preferences_are_private_and_excluded_from_change_feed"
        }
      ]
    },
    {
      "name": "manager_agent_runtime_authority_boundary",
      "kind": "infrastructure_exemption",
      "producer": "external Manager agent runtime",
      "rationale": "Scheduled-task and queue durability belongs to the attached Manager agent runtime; CRM delegates without changing CRM business state.",
      "routes": [
        "/api/agent_enqueue_task",
        "/api/delete_agent_scheduled_task",
        "/api/pause_agent_scheduled_task",
        "/api/resume_agent_scheduled_task",
        "/api/run_agent_scheduled_task",
        "/api/save_agent_scheduled_task"
      ],
      "route_evidence": {
        "/api/agent_enqueue_task": {
          "source": "src/minimal_kanban/services/card_service.py",
          "pattern": "return self._agent_control.agent_enqueue_task(payload)"
        },
        "/api/delete_agent_scheduled_task": {
          "source": "src/minimal_kanban/services/card_service.py",
          "pattern": "return self._agent_control.delete_agent_scheduled_task(payload)"
        },
        "/api/pause_agent_scheduled_task": {
          "source": "src/minimal_kanban/services/card_service.py",
          "pattern": "return self._agent_control.pause_agent_scheduled_task(payload)"
        },
        "/api/resume_agent_scheduled_task": {
          "source": "src/minimal_kanban/services/card_service.py",
          "pattern": "return self._agent_control.resume_agent_scheduled_task(payload)"
        },
        "/api/run_agent_scheduled_task": {
          "source": "src/minimal_kanban/services/card_service.py",
          "pattern": "return self._agent_control.run_agent_scheduled_task(payload)"
        },
        "/api/save_agent_scheduled_task": {
          "source": "src/minimal_kanban/services/card_service.py",
          "pattern": "return self._agent_control.save_agent_scheduled_task(payload)"
        }
      },
      "test_evidence": [
        {
          "source": "tests/test_change_feed_producers.py",
          "pattern": "test_agent_runtime_routes_are_external_authority_and_do_not_forge_crm_events"
        }
      ]
    },
    {
      "name": "change_feed_consumer_checkpoint_boundary",
      "kind": "infrastructure_exemption",
      "producer": "none",
      "rationale": "Bootstrap and ACK mutate only owner delivery checkpoints; emitting them into the same feed would create an infinite self-observation loop.",
      "routes": [
        "/api/change_feed/ack",
        "/api/change_feed/bootstrap"
      ],
      "route_evidence": {
        "/api/change_feed/ack": {
          "source": "src/minimal_kanban/api/change_feed.py",
          "pattern": "CHANGE_FEED_ACK_ROUTE = \"/api/change_feed/ack\""
        },
        "/api/change_feed/bootstrap": {
          "source": "src/minimal_kanban/api/change_feed.py",
          "pattern": "CHANGE_FEED_BOOTSTRAP_ROUTE = \"/api/change_feed/bootstrap\""
        }
      },
      "test_evidence": [
        {
          "source": "tests/test_change_feed.py",
          "pattern": "test_bootstrap_does_not_open_or_ack_owner_delivery"
        },
        {
          "source": "tests/test_change_feed.py",
          "pattern": "test_ack_is_ordered_idempotent_and_final_page_closes_delivery"
        }
      ]
    },
    {
      "name": "non_mutating_compatibility_and_artifact_routes",
      "kind": "non_mutating_exemption",
      "producer": "none",
      "rationale": "These compatibility routes return clipboard metadata, render an artifact, or fail closed; they do not commit durable CRM business state.",
      "routes": [
        "/api/copy_shared_file",
        "/api/correct_repair_order_number",
